# Optional: server-only verifier for the already-deployed Sepolia contracts.
# Leave empty for local demo play. Never distribute a real key in an archive.
MEADOW_REWARD_SIGNER_KEY=
# Optional port. Keep 4389 to use the existing local browser save.
MEADOW_PORT=4389
# Optional reliable Sepolia RPC. Never put its credential in frontend code.
# MEADOW_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
